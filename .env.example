# Copy this file to .env.development or .env.production and fill in that environment.
# Uncommented values are for local development. Commented values are for production.
# Development must use local PostgreSQL. Production must use the Neon pooler.

# development | production
APP_ENV=development
# APP_ENV=production

# API port. pnpm dev requires 3000.
PORT=3000

# Page port. pnpm dev requires 5173. Vite proxies /api to the API.
WEB_PORT=5173

# Browser origin. Better Auth uses it for cookies, trusted origins, and the JWT issuer.
AUTH_PUBLIC_URL=http://localhost:5173
# AUTH_PUBLIC_URL=https://borrow-desk.vercel.app

# Admin addresses, separated by commas. Comparison ignores case.
ADMIN_EMAIL=ada@example.com,bob@example.com

# Local database.
DATABASE_URL=postgresql://postgres:admin@localhost:5432/borrow_desk
# Pooled Neon database. The host must contain -pooler and end in .neon.tech.
# DATABASE_URL=postgresql://neondb_owner:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Development: prepare=true and max=10. Production: prepare=false and max=1.
PG_PREPARE=true
# PG_PREPARE=false
PG_MAX_CONNECTIONS=10
# PG_MAX_CONNECTIONS=1
PG_IDLE_TIMEOUT="30 seconds"
# PG_IDLE_TIMEOUT="10 seconds"

# Production signing secret, at least 16 characters. Development ignores this and uses a fixed local secret.
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# Production auth URLs kept from the hosted auth setup.
NEON_AUTH_BASE_URL=https://auth.example.neon.tech/neondb/auth
VITE_NEON_AUTH_URL=https://auth.example.neon.tech/neondb/auth
